{
    "name": "sync-notes",
    "version": "1.0.0",
    "description": "A Fullstack document management tool",
    "private": true,
    "main": "index.js",
    "scripts": {
        "dev:web:local": "pnpm --filter @sync-notes/web dev",
        "dev:web:prod": "pnpm --filter @sync-notes/web dev:prod",
        "dev:api:local": "pnpm --filter @sync-notes/api start:dev:local",
        "dev:api:prod": "pnpm --filter @sync-notes/api start:dev:prod",
        "build:api": "pnpm --filter @sync-notes/api build",
        "build:web": "pnpm --filter @sync-notes/web build",
        "preview:web": "pnpm --filter @sync-notes/web preview",
        "build": "pnpm -r build",
        "lint": "pnpm -r lint",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "11.24.0",
            "onFail": "download"
        }
    },
    "packageManager": "pnpm@11.24.0",
    "type": "module",
    "devDependencies": {
        "typescript": "^6.0.3"
    }
}
